ADMIN_USERNAME=admin@psm
ADMIN_PASSWORD_HASH=generate_with_npm_run_set-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PORT=3000
INTERNHUB_DATA_DIR=./data

# Supabase Database Configuration
# Obtain your URL & key from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_KEY=<your-supabase-anon-or-publishable-key>
